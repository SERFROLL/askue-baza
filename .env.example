# Образец. На сервере: cp .env.example .env и заполнить. Файл .env в git не попадает.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Telegram. Бот включается строкой COMPOSE_PROFILES=bot, когда задан токен.
#COMPOSE_PROFILES=bot
TELEGRAM_BOT_TOKEN=
# id чатов через запятую (группа охраны, Фролков). Узнать id: написать боту /id в нужном чате.
TELEGRAM_CHAT_IDS=
# Если api.telegram.org недоступен напрямую:
#TELEGRAM_PROXY=socks5h://127.0.0.1:1080
#TELEGRAM_API_BASE=https://relay.example/telegram
