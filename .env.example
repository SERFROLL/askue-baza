# Образец. На сервере: cp .env.example .env и заполнить. Файл .env в git не попадает.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Telegram. Бот включается строкой COMPOSE_PROFILES=bot, когда задан токен.
#COMPOSE_PROFILES=bot
TELEGRAM_BOT_TOKEN=
# id чатов через запятую. Узнать id: написать боту /id в нужном чате (бот пишет id в журнал).
# Администраторы: полные отчёты, утренняя сводка, расход, техника.
TELEGRAM_CHAT_IDS=
# Охрана: вечером только «не выключенные», ночные предупреждения, кнопки «Сейчас» и графики.
TELEGRAM_GUARD_IDS=
# 1 — бот отвечает всем (всё меню); рассылки по расписанию всё равно только в чаты из списков выше.
# Чтобы ограничить доступ, поставить пусто или 0 и перезапустить: docker compose up -d
TELEGRAM_OPEN_ACCESS=1
# Если api.telegram.org недоступен напрямую:
#TELEGRAM_PROXY=socks5h://127.0.0.1:1080
#TELEGRAM_API_BASE=https://relay.example/telegram
