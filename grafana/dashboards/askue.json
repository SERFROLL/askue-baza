        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT o.name AS \"Объект\", avg(f.p) AS \"кВт\"\nFROM object_power_fast f JOIN objects o ON o.id = f.object_id\nWHERE f.ts > now() - interval '10 seconds'\nGROUP BY o.name, o.sort ORDER BY o.sort"
        }
      ]
    },
