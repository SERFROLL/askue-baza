    {
      "id": 4,
      "type": "table",
      "title": "Энергия за выбранный период — по показаниям счётчиков энергии (для сверки с энергосбытом)",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 10,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "askue-pg"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "кВт·ч"
            },
            "properties": [
              {
                "id": "unit",
                "value": "kwatth"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH t AS (\n  SELECT o.name, o.sort, t.point, t.sign,\n   GREATEST(COALESCE(t.valid_from, '-infinity'), $__timeFrom()::timestamptz) AS a,\n   LEAST(COALESCE(t.valid_to, 'infinity'), $__timeTo()::timestamptz) AS b\n  FROM objects o JOIN object_terms t ON t.object_id = o.id),\nd AS (\n  SELECT t.*,\n   (SELECT e_import FROM readings r WHERE r.point = t.point AND r.ts >= t.a AND r.ts < t.b ORDER BY ts DESC LIMIT 1)\n - (SELECT e_import FROM readings r WHERE r.point = t.point AND r.ts >= t.a AND r.ts < t.b ORDER BY ts LIMIT 1) AS dd\n  FROM t WHERE t.a < t.b)\n-- состав объекта по периодам (history в config.yaml): каждый период считается по своим точкам\nSELECT name AS \"Объект\", GREATEST(sum(sign * dd), 0) AS \"кВт·ч\"\nFROM d GROUP BY name, sort ORDER BY sort"
        }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Показания счётчиков энергии (приём) на начало и конец периода, кВт·ч",
      "gridPos": {
        "x": 10,
        "y": 24,
        "w": 14,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "askue-pg"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT p.name AS \"Канал счётчика\", a.ts AS \"Начало\", a.e AS \"Показание\", b.ts AS \"Конец\", b.e AS \"Показание \", b.e - a.e AS \"Разность\"\nFROM points p\nLEFT JOIN LATERAL (SELECT ts, e_import AS e FROM readings r WHERE r.point = p.id AND $__timeFilter(r.ts) ORDER BY ts LIMIT 1) a ON true\nLEFT JOIN LATERAL (SELECT ts, e_import AS e FROM readings r WHERE r.point = p.id AND $__timeFilter(r.ts) ORDER BY ts DESC LIMIT 1) b ON true\nORDER BY p.sort"
        }
      ]
    },
