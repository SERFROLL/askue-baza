          "editorMode": "code",
          "rawSql": "SELECT to_char(e.day, 'DD.MM.YYYY') AS \"День\", o.name, e.kwh\nFROM object_energy_day e JOIN objects o ON o.id = e.object_id\nWHERE e.day >= ($__timeFrom() AT TIME ZONE 'Asia/Krasnoyarsk')::date AND NOT o.is_total AND NOT EXISTS (SELECT 1 FROM objects c WHERE c.parent = o.id)\nORDER BY e.day, o.sort"
